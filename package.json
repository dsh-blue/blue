{
  "name": "@dsh-blue/blue-root",
  "version": "0.1.0-rc.7",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node script/generate-blue-plugin-contract.mjs --check && node script/clean-lib.mjs && tsc -b tsconfig.json --force && node script/prune-types.mjs && tsdown",
    "test": "vitest run",
    "test:repo-workflow": "node --test script/tests/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "oxlint packages examples",
    "diagrams:sync": "node script/sync-diagrams.mjs",
    "diagrams:check": "node script/sync-diagrams.mjs --check",
    "check:lib": "node script/check-lib-exports.mjs",
    "check:pack": "node script/check-pack.mjs",
    "check:examples": "node script/check-examples.mjs",
    "release:version": "node script/release-version.mjs",
    "smoke:happy": "node script/smoke-happy.mjs",
    "smoke:pty": "node script/smoke-pty.mjs",
    "smoke:pty:mouse": "node script/smoke-pty-mouse.mjs",
    "smoke:pty:output": "node script/smoke-pty-output-recovery.mjs",
    "blue:plugin-validate": "node script/blue-plugin-validate.mjs",
    "blue:plugin-fixture": "node script/blue-plugin-fixture.mjs",
    "generate:plugin-contract": "node script/generate-blue-plugin-contract.mjs",
    "check:plugin-contract": "node script/generate-blue-plugin-contract.mjs --check",
    "check:plugin-authoring-docs": "node script/check-plugin-authoring-docs.mjs",
    "check:agent-docs": "node script/check-agent-docs.mjs",
    "verify:changed": "node script/verify-changed.mjs",
    "verify:full": "node script/verify-changed.mjs --full --smoke",
    "build:changed": "node script/build-changed.mjs",
    "fixture:plugin-tutorial": "node script/blue-plugin-tutorial-fixture.mjs",
    "fixture:context-upstream": "node script/context-upstream-fixture.mjs",
    "fixture:remote-upstream": "node script/remote-upstream-fixture.mjs",
    "website:dev": "node script/marketplace-fetch.mjs --allow-missing && pnpm --filter @dsh-blue/website run dev",
    "website:build": "node script/marketplace-fetch.mjs && pnpm --filter @dsh-blue/website run build",
    "website:preview": "pnpm --filter @dsh-blue/website run preview",
    "marketplace:fetch": "node script/marketplace-fetch.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-mock-server": "0.1.2-alpha.2",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@xterm/headless": "6.0.0",
    "commander": "15.0.0",
    "node-pty": "1.2.0-beta.15",
    "oxlint": "1.76.0",
    "publint": "0.3.24",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "2.9.0"
  }
}
