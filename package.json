{
  "name": "@dsh-blue/blue-root",
  "version": "0.1.0-rc.7",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "oxlint packages",
    "website:dev": "pnpm --filter @dsh-blue/website run dev",
    "website:build": "pnpm --filter @dsh-blue/website run build",
    "website:preview": "pnpm --filter @dsh-blue/website run preview"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "oxlint": "1.76.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
