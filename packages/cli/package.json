{
  "name": "@dsh-blue/blue-cli",
  "description": "The blue launcher: pins the dsh host, calibrates the Blue bundle into its profile, and boots the TUI",
  "version": "0.1.0-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "blue": "lib/bin.js"
  },
  "files": [
    "lib/bin.js",
    "npm-shrinkwrap.json",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-blue/blue.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "blue",
    "cli",
    "terminal-ui",
    "coding-agent",
    "ai-agent",
    "command-line"
  ]
}

