{
  "name": "@dsh-blue/blue-interaction",
  "description": "Blue terminal UI interaction layer: input editor, slash commands, approval and user-question overlays over dsh-blue-core",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./editor-plus": {
      "types": "./lib/types/editor-plus.d.ts",
      "default": "./lib/editor-plus.js"
    },
    "./pane-queue": {
      "types": "./lib/types/pane-queue.d.ts",
      "default": "./lib/pane-queue.js"
    },
    "./mode-status": {
      "types": "./lib/types/mode-status.d.ts",
      "default": "./lib/mode-status.js"
    },
    "./command-model": {
      "types": "./lib/types/command-model.d.ts",
      "default": "./lib/command-model.js"
    },
    "./attachments": {
      "types": "./lib/types/attachments.d.ts",
      "default": "./lib/attachments.js"
    },
    "./attach-view": {
      "types": "./lib/types/attach-view.d.ts",
      "default": "./lib/attach-view.js"
    },
    "./paste-image": {
      "types": "./lib/types/paste-image.d.ts",
      "default": "./lib/paste-image.js"
    },
    "./plugin-host-bridge": {
      "types": "./lib/types/plugin-host-bridge.d.ts",
      "default": "./lib/plugin-host-bridge.js"
    },
    "./editor-provider-owner": {
      "types": "./lib/types/editor-provider-owner.d.ts",
      "default": "./lib/editor-provider-owner.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-blue/blue.git",
    "directory": "packages/interaction"
  },
