{
  "name": "@dsh-blue/blue-ui",
  "description": "Pure renderer-neutral builders for Blue's public UI wire format",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-blue/blue.git",
    "directory": "packages/ui"
  },
  "dependencies": {
    "@dsh-blue/blue-api": "workspace:*"
  }
}
