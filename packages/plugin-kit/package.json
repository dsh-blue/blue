{
  "name": "@dsh-blue/blue-plugin-kit",
  "description": "No-checkout authoring, validation, and conformance CLI for Blue plugins",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "blue-plugin": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "runtime/*.mjs",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-blue/blue.git",
    "directory": "packages/plugin-kit"
  },
  "dependencies": {
    "@dsh-blue/blue-api": "workspace:*",
    "@dsh-blue/blue-ui": "workspace:*",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "validate-npm-package-name": "7.0.2"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "@types/validate-npm-package-name": "4.0.2"
  }
}
