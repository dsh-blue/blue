{
  "name": "@dsh-blue/blue-transcript",
  "description": "Blue terminal UI transcript layer: folds session events into transcript items and renders them through dsh-blue-core",
  "version": "0.1.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./status-basic": {
      "types": "./lib/types/status-basic.d.ts",
      "default": "./lib/status-basic.js"
    },
    "./status-cwd": {
      "types": "./lib/types/status-cwd.d.ts",
      "default": "./lib/status-cwd.js"
    },
    "./status-title": {
      "types": "./lib/types/status-title.d.ts",
      "default": "./lib/status-title.js"
    },
    "./status-git": {
      "types": "./lib/types/status-git.d.ts",
      "default": "./lib/status-git.js"
    },
    "./status-context": {
      "types": "./lib/types/status-context.d.ts",
      "default": "./lib/status-context.js"
    },
    "./pane-activity": {
      "types": "./lib/types/pane-activity.d.ts",
      "default": "./lib/pane-activity.js"
    },
    "./pane-todo": {
      "types": "./lib/types/pane-todo.d.ts",
      "default": "./lib/pane-todo.js"
    },
    "./pane-btw": {
      "types": "./lib/types/pane-btw.d.ts",
      "default": "./lib/pane-btw.js"
    },
    "./intent-diff": {
      "types": "./lib/types/intent-diff.d.ts",
      "default": "./lib/intent-diff.js"
    },
    "./intent-terminal": {
      "types": "./lib/types/intent-terminal.d.ts",
      "default": "./lib/intent-terminal.js"
    },
    "./banner": {
      "types": "./lib/types/banner.d.ts",
      "default": "./lib/banner.js"
    },
    "./banner-content": {
      "types": "./lib/types/banner-content.d.ts",
      "default": "./lib/banner-content.js"
    },
    "./pane-agents": {
      "types": "./lib/types/pane-agents.d.ts",
      "default": "./lib/pane-agents.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-blue/blue.git",
    "directory": "packages/transcript"
  },
  "peerDependencies": {
    "@dsh-blue/blue-api": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@dsh-blue/blue-app": "workspace:^",
    "@dsh-blue/blue-core": "workspace:^",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@dsh-blue/blue-api": "workspace:^",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@dsh-blue/blue-app": "workspace:^",
    "@dsh-blue/blue-core": "workspace:^",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  }
}
